{
  "schemaVersion": 1,
  "id": "packed_packs",
  "version": "${version}",
  "name": "Packed Packs",
  "description": "Pack packs into profiles with multiple selection, drag and drop, and extended mouse and keyboard controls.",
  "authors": [
    "fishstiz"
  ],
  "contributors": [
    "StarmanMine142"
  ],
  "contact": {
    "sources": "https://github.com/fishstiz/packed_packs",
    "issues": "https://github.com/fishstiz/packed_packs/issues"
  },
  "license": "MIT",
  "icon": "assets/packed_packs/icon.png",
  "environment": "client",
  "entrypoints": {
    "minecraft-cursor": [
      "io.github.fishstiz.packed_packs.compat.minecraftcursor.PackedPacksMinecraftCursor"
    ],
    "modmenu": [
      "io.github.fishstiz.packed_packs.compat.modmenu.PackedPacksModMenu"
    ]
  },
  "mixins": [
    {
      "config": "packed_packs.mixins.json",
      "environment": "client"
    },
    {
      "config": "fidgetz.mixin.json",
      "environment": "client"
    }
  ],
  "accessWidener": "packed_packs.accesswidener",
  "depends": {
    "fabricloader": ">=0.16.10",
    "minecraft": ">=1.21.6",
    "java": ">=21",
    "fabric-api": "*"
  }
}